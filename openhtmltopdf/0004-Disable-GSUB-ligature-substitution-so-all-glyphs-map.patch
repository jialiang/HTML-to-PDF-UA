From 98572627de49af5e978acbb50aa1ee5c8625a284 Mon Sep 17 00:00:00 2001
From: Jia Liang <hojialiang@protonmail.com>
Date: Tue, 23 Jun 2026 03:13:55 +0800
Subject: [PATCH 4/4] Disable GSUB ligature substitution so all glyphs map to
 Unicode for PDF/UA and PDF/A

---
 .../pdfboxout/PdfBoxFontResolver.java         | 26 ++++++++++++++++---
 1 file changed, 23 insertions(+), 3 deletions(-)

diff --git a/openhtmltopdf-pdfbox/src/main/java/com/openhtmltopdf/pdfboxout/PdfBoxFontResolver.java b/openhtmltopdf-pdfbox/src/main/java/com/openhtmltopdf/pdfboxout/PdfBoxFontResolver.java
index 380beea9..3ea34557 100644
--- a/openhtmltopdf-pdfbox/src/main/java/com/openhtmltopdf/pdfboxout/PdfBoxFontResolver.java
+++ b/openhtmltopdf-pdfbox/src/main/java/com/openhtmltopdf/pdfboxout/PdfBoxFontResolver.java
@@ -41,6 +41,10 @@ import com.openhtmltopdf.util.LogMessageId;
 import com.openhtmltopdf.util.XRLog;
 
 import org.apache.fontbox.ttf.TrueTypeCollection;
+import org.apache.fontbox.ttf.TTFParser;
+import org.apache.fontbox.ttf.TrueTypeFont;
+import org.apache.pdfbox.io.RandomAccessRead;
+import org.apache.pdfbox.io.RandomAccessReadBuffer;
 import org.apache.pdfbox.pdmodel.PDDocument;
 import org.apache.pdfbox.pdmodel.font.PDFont;
 import org.apache.pdfbox.pdmodel.font.PDFontDescriptor;
@@ -51,6 +55,7 @@ import java.io.File;
 import java.io.FilenameFilter;
 import java.io.IOException;
 import java.io.InputStream;
+import java.nio.file.Files;
 import java.util.*;
 import java.util.logging.Level;
 
@@ -302,6 +307,21 @@ public class PdfBoxFontResolver implements FontResolver, Closeable {
         this._suppliedFonts.addFontLazy(new FilePDFontSupplier(fontFile, _doc), fontFamilyNameOverride, fontWeightOverride, fontStyleOverride, subset);
 	}
 
+	/**
+	 * GSUB off so FontBox adds no ligature glyphs, which have no Unicode mapping and
+	 * break PDF/UA and PDF/A (7.21.7, 8.4.5.8). The overload taking a TrueTypeFont
+	 * does not own it, so register it for closing.
+	 */
+	private static PDFont loadFontWithGsubDisabled(PDDocument doc, RandomAccessRead source, boolean subset) throws IOException {
+		TrueTypeFont ttf = new TTFParser().parse(source);
+		ttf.setEnableGsub(false);
+
+		PDFont font = PDType0Font.load(doc, ttf, subset);
+		doc.registerTrueTypeFontForClosing(ttf);
+
+		return font;
+	}
+
 	/**
 	 * Loads a Type0 font on demand
 	 */
@@ -317,7 +337,7 @@ public class PdfBoxFontResolver implements FontResolver, Closeable {
 		@Override
 		public PDFont supply() {
 			try {
-				return PDType0Font.load(_doc, _fontFile);
+				return loadFontWithGsubDisabled(_doc, new RandomAccessReadBuffer(Files.readAllBytes(_fontFile.toPath())), true);
 			} catch (IOException e) {
 			    XRLog.log(Level.WARNING, LogMessageId.LogMessageId1Param.EXCEPTION_COULD_NOT_LOAD_FONT, _fontFile.getAbsoluteFile(), e);
 			    return null;
@@ -669,8 +689,8 @@ public class PdfBoxFontResolver implements FontResolver, Closeable {
                 }
                 
                 try {
-                    _font = PDType0Font.load(_doc, is, _isSubset);
-                    
+                    _font = loadFontWithGsubDisabled(_doc, new RandomAccessReadBuffer(is), _isSubset);
+
                     if (!isMetricsAvailable()) {
                         return loadMetrics();
                     }
