From 1091ca5eca7e0ca50a5204443930afa2f463c9e3 Mon Sep 17 00:00:00 2001
From: Jia Liang <hojialiang@protonmail.com>
Date: Mon, 22 Jun 2026 03:08:09 +0800
Subject: [PATCH 3/3] Keep inter-word gaps extractable under negative
 letter-spacing

---
 .../openhtmltopdf/pdfboxout/PdfBoxFastOutputDevice.java    | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/openhtmltopdf-pdfbox/src/main/java/com/openhtmltopdf/pdfboxout/PdfBoxFastOutputDevice.java b/openhtmltopdf-pdfbox/src/main/java/com/openhtmltopdf/pdfboxout/PdfBoxFastOutputDevice.java
index a4e0c4c..3e176a3 100644
--- a/openhtmltopdf-pdfbox/src/main/java/com/openhtmltopdf/pdfboxout/PdfBoxFastOutputDevice.java
+++ b/openhtmltopdf-pdfbox/src/main/java/com/openhtmltopdf/pdfboxout/PdfBoxFastOutputDevice.java
@@ -512,6 +512,13 @@ public class PdfBoxFastOutputDevice extends AbstractOutputDevice implements Outp
                     info.getSpaceAdjust() :
                     info.getNonSpaceAdjust();
 
+            // Negative letter-spacing must not shrink inter-word gaps, otherwise
+            // text extraction merges words (e.g. "Bachelor of" -> "Bachelorof").
+            // Tighten letters only; leave space advances at their natural width.
+            if (InlineText.isJustifySpaceCodePoint(cp) && offset < 0) {
+                offset = 0;
+            }
+
             data.add(Float.valueOf((-offset / _dotsPerPoint) * 1000 / (_font.getSize2D() / _dotsPerPoint)));
         });
 
-- 
