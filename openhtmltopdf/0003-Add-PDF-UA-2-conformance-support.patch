     public static PDStructureElement getStructualElementForBox(Box targetBox) {
-        if (targetBox != null &&
-            targetBox.getAccessibilityObject() != null &&
-            targetBox.getAccessibilityObject() instanceof AbstractStructualElement) {
+        if (targetBox == null) {
