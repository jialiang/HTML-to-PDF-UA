+    /**
+     * Builds a PDF 2.0 structure destination array referencing the given structure element.
+     * With a page destination it mirrors its coordinates (<code>[structElem /XYZ left top zoom]</code>);
+     * without one it falls back to <code>[structElem /Fit]</code>.
+     */
+    private static COSArray createStructureDestination(PDStructureElement se, PDPageXYZDestination pageDest) {
+        COSArray sd = new COSArray();
+        sd.add(se.getCOSObject());
+
+        if (pageDest == null) {
+            sd.add(COSName.getPDFName("Fit"));
+            return sd;
+        }
+
+        sd.add(COSName.getPDFName("XYZ"));
+
+        int left = pageDest.getLeft();
+        int top = pageDest.getTop();
+        float zoom = pageDest.getZoom();
+
+        sd.add(left >= 0 ? COSInteger.get(left) : COSNull.NULL);
+        sd.add(top >= 0 ? COSInteger.get(top) : COSNull.NULL);
+        sd.add(zoom > 0 ? new COSFloat(zoom) : COSNull.NULL);
+
+        return sd;
+    }
