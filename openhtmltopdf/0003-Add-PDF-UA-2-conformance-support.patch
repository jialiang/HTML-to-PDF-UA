+    /**
+     * Whether to conform to PDF/UA, and which part of ISO 14289 to target.
+     * <p>
+     * Part 1 (PDF/UA-1) targets ISO 32000-1 (PDF 1.7); part 2 (PDF/UA-2) targets
+     * ISO 32000-2 (PDF 2.0) and additionally tags the structure tree with the
+     * PDF 2.0 standard structure namespace. The legacy role map is retained either
+     * way, so UA-1 consumers can still read a UA-2 document.
+     *
+     * @param pdfUaAccessibility whether to enable PDF/UA conformance
+     * @param pdfUaVersion       1 for PDF/UA-1, 2 for PDF/UA-2
+     */
+    public PdfRendererBuilder usePdfUaAccessibility(boolean pdfUaAccessibility, int pdfUaVersion) {
+        this.state._pdfUaConform = pdfUaAccessibility;
+        this.state._pdfUaVersion = pdfUaVersion;
+        return this;
+    }
