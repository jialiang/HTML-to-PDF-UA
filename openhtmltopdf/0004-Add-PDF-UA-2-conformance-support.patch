+    /**
+     * Creates the PDF 2.0 standard structure namespace dictionary and registers it in
+     * the structure tree root's /Namespaces array. Returns null for PDF/UA-1, where no
+     * namespace is used. The returned dictionary is shared by reference, so PDFBox writes
+     * it as a single indirect object that every /NS entry then references.
+     */
+    private COSDictionary createPdf2StructureNamespace(PDStructureTreeRoot root) {
+        if (_pdfUaVersion < 2) {
+            return null;
+        }
+
+        COSDictionary namespace = new COSDictionary();
+        namespace.setItem(COSName.TYPE, COSName.getPDFName("Namespace"));
+        namespace.setString(NS, PDF2_STRUCTURE_NAMESPACE);
+
+        COSArray namespaces = new COSArray();
+        namespaces.add(namespace);
+        root.getCOSObject().setItem(COSName.getPDFName("Namespaces"), namespaces);
+
+        return namespace;
+    }
+
+    /**
+     * Recursively sets /NS on a structure element and all of its structure-element
+     * descendants. Non-structure kids (marked content, object references, mcids) are
+     * skipped.
+     */
+    private void applyStructureNamespace(PDStructureElement elem, COSDictionary namespace) {
+        elem.getCOSObject().setItem(NS, namespace);
+
+        List<Object> kids = elem.getKids();
+        if (kids == null) {
+            return;
+        }
+
+        for (Object kid : kids) {
+            if (kid instanceof PDStructureElement) {
+                applyStructureNamespace((PDStructureElement) kid, namespace);
+            }
+        }
+    }
+
